<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | Bitácora</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0a0a12;
            --card-bg: rgba(30, 15, 30, 0.95);
            --text-gold: #f0e6d2;
            --text-muted: #c7a0d6;
            --link-color: #dba6f0;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background-color: var(--bg-dark);
            color: var(--text-gold);
            font-family: 'Lora', serif;
            line-height: 1.8;
            padding: 40px 20px;
            min-height: 100vh;
        }
        .blog-container {
            max-width: 750px;
            margin: 0 auto;
            background: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
        }
        h1, h2, h3 {
            font-family: 'Cinzel', serif;
            color: var(--text-gold);
            margin-bottom: 20px;
        }
        h1 { font-size: 2.2rem; border-bottom: 1px solid rgba(255, 255, 255, 0.2); padding-bottom: 15px; }
        h2 { font-size: 1.5rem; margin-top: 30px; color: var(--text-muted); }
        p { margin-bottom: 20px; font-size: 1.05rem; }
        ul { margin-left: 20px; margin-bottom: 25px; }
        li { margin-bottom: 10px; }
        a { color: var(--link-color); text-decoration: none; transition: opacity 0.2s; }
        a:hover { text-decoration: underline; opacity: 0.8; }
        .nav-back {
            display: inline-block;
            margin-bottom: 25px;
            font-family: 'Cinzel', serif;
            font-size: 0.9rem;
            color: var(--text-gold);
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 6px 16px;
            border-radius: 20px;
        }
        .nav-back:hover { background: rgba(255, 255, 255, 0.1); text-decoration: none; }
        /* Formato métrico para poesía */
        .poema {
            white-space: pre-line;
            font-style: italic;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="blog-container">
        <a href="/" class="nav-back">← Volver al inicio</a>
        <h1>{{ title }}</h1>
        {{ content | safe }}
    </div>
</body>
</html>
