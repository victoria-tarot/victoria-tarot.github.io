<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - Bitácora Literaria</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Lato:wght@300;400;700&family=Lora:ital,wght@0,400;1,400&family=Merriweather:wght@300;400&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Lato', sans-serif;
            background-color: #0a0a12;
            color: #ffffff;
            background-image: url('/fondo.png');
            background-size: cover;
            background-attachment: fixed;
            margin: 0; padding: 0;
        }
        .nav-bar { padding: 20px; text-align: center; margin-top: 20px; }
        .btn-back { background: transparent; border: 1px solid white; color: white; padding: 10px 25px; border-radius: 50px; text-decoration: none; font-family: 'Cinzel', serif; transition: 0.3s; }
        .btn-back:hover { background: white; color: black; }
        
        .blog-container {
            max-width: 750px; margin: 20px auto 40px; padding: 40px;
            background-color: rgba(30, 15, 30, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.6);
        }
        h1 { 
            font-family: 'Cinzel', serif; color: #f0e6d2; text-align: center; 
            border-bottom: 1px solid rgba(255,255,255,0.2); padding-bottom: 20px; margin-bottom: 30px; 
        }
        
        /* Conteneur principal pour le texte Markdown */
        .contenido-literario {
            font-family: 'Lora', 'Merriweather', serif; 
            color: #e0e0e0; 
            line-height: 1.8;
            font-size: 1.1rem;
            white-space: pre-wrap; /* Maintient les sauts de ligne de la poésie */
        }
        .contenido-literario a { color: #dba6f0; text-decoration: none; }
        .contenido-literario a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="nav-bar">
        <a href="/" class="btn-back">← Volver al inicio</a>
    </div>
    <div class="blog-container">
        <h1>{{ title }}</h1>
        <div class="contenido-literario">
{{ content | safe }}
        </div>
    </div>
</body>
</html>
